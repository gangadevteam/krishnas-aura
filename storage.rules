rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-images/{fileName} {
      // Anyone can view product photos (they're shown in the public storefront).
      allow read: if true;
      // Only the seller account can upload/replace/delete them, and only
      // images under 5MB.
      allow write: if request.auth != null
        && request.auth.token.email == 'krishnasaaura@gmail.com'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
